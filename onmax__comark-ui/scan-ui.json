  "flows": [
    {
      "id": "render",
      "name": "Render with the preset",
      "trigger": "comarkUi() from comark-ui/html",
      "steps": [
        "cmp:HtmlEntry",
        "cmp:Preset",
        "state:PresetOptions",
        "ext:ComarkHtml"
      ],
      "summary": "Entry imports every package, preset() orders them, the host walks the tree."
    },
    {
      "id": "disable",
      "name": "Turn a plugin off",
      "trigger": "comarkUi({ zoom: false })",
      "steps": [
        "state:PresetOptions",
        "cmp:Preset",
        "ext:Zoom"
      ],
      "summary": "`false` skips add(); an object passes options through optionsOf()."
    },
    {
      "id": "editor",
      "name": "Mount the editor",
      "trigger": "comark-ui/editor/vue",
      "steps": [
        "cmp:EditorVue",
        "cmp:EditorEntry",
        "cmp:EditorKit",
        "ext:TipTap"
      ],
      "summary": "TipTap with the same plugins the renderer uses; Markdown in and out."
    },
    {
      "id": "theme",
      "name": "Adopt Nuxt UI colours",
      "trigger": "nuxtUiTheme(uiColors, css)",
      "steps": [
        "cmp:NuxtTheme",
        "cmp:Palette",
        "shared:Tokens"
      ],
      "summary": "Resolves each colour from Tailwind's palette into --ui-* then --comark-*."
    },
    {
      "id": "typeset",
      "name": "Style the prose",
      "trigger": "Any page rendered with comark-ui",
      "steps": [
        "cmp:Preset",
        "cmp:Typeset",
        "cmp:TypesetCss",
        "cmp:HtmlEntry"
      ],
      "summary": "One style node per document, in the serving render, so no shift on hydration."
    },
    {
      "id": "mermaid",
      "name": "Theme a Mermaid diagram",
      "trigger": "Pea draws a diagram in Vue",
      "steps": [
        "cmp:Client",
        "shared:Tokens",
        "ipc:Dom"
      ],
      "summary": "--pele-* variables mapped to comark tokens, style added once."
    }
  ],
  "notes": [
    {
      "title": "Order is the contract",
      "body": "preset() (index.ts:177) adds include first and code last, and the comment says why; code-notes depends on running after Shiki, media before zoom. That order lives only here.",
      "severity": "warn",
      "path": "packages/ui/src/index.ts"
    },
    {
      "title": "Four renderer entries repeat the same list",
      "body": "html.ts, vue.ts, react.ts and svelte/index.js each import the same ~35 packages by hand and differ only in annotate/diff; a new package means editing all four plus the Renderer type.",
      "severity": "warn",
      "path": "packages/ui/src/vue.ts"
    },
    {
      "title": "No script for the preset itself",
      "body": "The preset only adds plugins and components; client.ts is 39 lines and does one thing (append the Mermaid style once). All behaviour lives in each package's own script.",
      "severity": "info",
      "path": "packages/ui/src/client.ts"
    },
    {
      "title": "The editor is a second surface",
      "body": "src/editor/ (1000 lines) keeps a TipTap schema in step with the Markdown parser, and editor-vue.ts adds Yjs. It is exported as comark-ui/editor, outside the preset.",
      "severity": "info",
      "path": "packages/ui/src/editor/markdown.ts"
    },
    {
      "title": "typeset is scoped, not global",
      "body": "typeset-css.ts wraps its rules in `@scope` with no selector and `@layer comark`, so the styles apply to the page they are emitted into and sit below every block's own rules.",
      "severity": "info",
      "path": "packages/ui/src/typeset-css.ts"
    },
    {
      "title": "One icon resolver, six consumers",
      "body": "preset() calls createIcons() once and hands the same `Icons` to icon, cards, details, file trees, tabs and code, so options and cache are shared instead of per package.",
      "severity": "info",
      "path": "packages/ui/src/index.ts"
    }
  ]
}