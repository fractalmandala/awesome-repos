      "from": "cmd:CopyCode",
      "to": "cmp:CodeActions",
      "kind": "commands"
    },
    {
      "from": "cmd:ZoomOpen",
      "to": "cmp:Zoom",
      "kind": "commands"
    },
    {
      "from": "cmd:QuizAnswer",
      "to": "cmp:Quiz",
      "kind": "commands"
    },
    {
      "from": "cmd:TabsSwitch",
      "to": "cmp:Tabs",
      "kind": "commands"
    },
    {
      "from": "cmd:TableSort",
      "to": "cmp:Table",
      "kind": "commands"
    }
  ],
  "flows": [
    {
      "id": "render",
      "name": "Render a document",
      "trigger": "comarkUi() in an app",
      "steps": [
        "cmp:Preset",
        "cmp:RendererEntries",
        "ext:Comark",
        "ext:ComarkRenderers"
      ],
      "summary": "preset() builds plugins and components; the host renderer walks the tree."
    },
    {
      "id": "lint",
      "name": "Lint documents",
      "trigger": "lint-comark 'docs/**/*.md'",
      "steps": [
        "cmd:LintCli",
        "cmp:Linter",
        "cmp:LintRules",
        "cmp:LintLinks",
        "ipc:Fs"
      ],
      "summary": "Parse once, then core and per-package rules; links resolved through disk."
    },
    {
      "id": "annotate",
      "name": "Annotated screenshot",
      "trigger": "::screenshot with ::annotation children",
      "steps": [
        "cmp:Annotate",
        "state:DocMeta",
        "cmp:RendererEntries"
      ],
      "summary": "The reader validates and reports, the renderer draws the same model; no script."
    },
    {
      "id": "chart",
      "name": "Chart with marks",
      "trigger": "::chart over a Markdown table",
      "steps": [
        "cmp:Charts",
        "cmp:ChartDraw",
        "cmp:Annotate",
        "ext:VegaFlint"
      ],
      "summary": "Read the table, draw SVG while parsing, place annotation marks on it."
    },
    {
      "id": "icon",
      "name": "Resolve an icon",
      "trigger": ":icon{name=\"lucide:apple\"}",
      "steps": [
        "cmp:Icon",
        "ipc:Iconify",
        "state:ProcessCaches",
        "cmp:RendererEntries"
      ],
      "summary": "One batched API call, cached per process, written as a data URI on the node."
    },
    {
      "id": "diagram",
      "name": "Draw a diagram",
      "trigger": "A plantuml fence",
      "steps": [
        "cmp:Diagrams",
        "ipc:Kroki",
        "state:ProcessCaches"
      ],
      "summary": "Source is POSTed to Kroki, the SVG sanitized and kept as a diagram node."
    },
    {
      "id": "docs",
      "name": "Build the docs site",
      "trigger": "pnpm docs:build",
      "steps": [
        "cmd:Build",
        "cmp:DocsBuild",
        "cmp:DocsWorker"
      ],
      "summary": "Packages build first, then every docs page, llms.txt and the skill."
    },
    {
      "id": "quiz",
      "name": "Answer a quiz",
      "trigger": "A reader clicks an option",
      "steps": [
        "cmd:QuizAnswer",
        "cmp:Quiz"
      ],
      "summary": "Inlined script reveals rationales; hosts can post state back."
    }
  ],
  "notes": [
    {
      "title": "One package shape, repeated 45 times",
      "body": "Each package is src/index.ts (parse plugin) plus html/vue/react/svelte entries and optional client.ts, script.ts, styles.ts; `defineComponentsPackage` (tsdown.shared.ts) fixes that layout.",
      "severity": "info",
      "path": "tsdown.shared.ts"
    },
    {
      "title": "Registration is checked by a test",
      "body": "test/workspace.test.ts asserts every manifest shares version, license, author, links and build script, and that each package has a skill reference linked from SKILL.md and a docs page.",
      "severity": "info",
      "path": "test/workspace.test.ts"
    },
    {
      "title": "Work happens at parse time, not render time",
      "body": "Charts (Vega/Flint), math (Temml), diagrams (Kroki), qr, icons and colors all write their result onto the node while parsing, so renderers only print markup and no client ships Vega, Temml or Shiki.",
      "severity": "info",
      "path": "packages/charts/src/index.ts"
    },
    {
      "title": "Renderer entries are hand-maintained",
      "body": "packages/ui/src/html.ts and index.ts each list ~40 package imports by hand; adding a plugin means editing the entries, the option type, the preset order, the linter catalog and the skill, five places.",
      "severity": "warn",
      "path": "packages/ui/src/index.ts"
    },
    {
      "title": "Two files carry most of the complexity",
      "body": "packages/charts/src/draw.ts (1369) plus read.ts (1065) are half the charts package; packages/lint/src/index.ts is 939 lines. Everything else in the workspace is under 700.",
      "severity": "warn",
      "path": "packages/charts/src/draw.ts"
    },
    {
      "title": "No TODO and almost no type escapes",
      "body": "Zero TODO/FIXME/HACK in packages, shared and docs; 4 `oxlint-disable-next-line no-explicit-any`, each with a written reason, and no `as any` in shipped code.",
      "severity": "info",
      "path": "packages/ui/src/index.ts"
    }
  ]
}