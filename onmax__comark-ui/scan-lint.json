  "flows": [
    {
      "id": "one",
      "name": "Lint one document",
      "trigger": "lint(markdown, options)",
      "steps": [
        "cmp:Lint",
        "cmp:Source",
        "cmp:Rules",
        "cmp:Words"
      ],
      "summary": "One parse, core checks then plugin issues; everything sorted by line and column."
    },
    {
      "id": "files",
      "name": "Lint a project",
      "trigger": "lint-comark 'docs/**/*.md'",
      "steps": [
        "cmd:LintCli",
        "cmp:Cli",
        "cmp:Lint",
        "state:HeadingIndex",
        "ipc:Fs"
      ],
      "summary": "Each file parsed once; links between files share one heading index."
    },
    {
      "id": "urls",
      "name": "Check external links",
      "trigger": "lint-comark --check-urls",
      "steps": [
        "cmp:Urls",
        "ipc:Http",
        "ipc:Fs"
      ],
      "summary": "8 requests at a time, 2 per host, answers cached in node_modules/.cache."
    },
    {
      "id": "doctor",
      "name": "Run Vite Doctor",
      "trigger": "pnpm run doctor",
      "steps": [
        "cmd:Doctor",
        "cmp:Doctor",
        "cmp:Lint",
        "ext:DoctorDocs"
      ],
      "summary": "Manifest rules glob Markdown, lint it, and link each code to its docs page."
    },
    {
      "id": "eslint",
      "name": "Lint from ESLint",
      "trigger": "eslint with the comark plugin",
      "steps": [
        "cmd:Eslint",
        "cmp:Eslint",
        "ipc:Worker",
        "cmp:EslintWorker",
        "cmp:Lint"
      ],
      "summary": "ESLint's Markdown processor yields text; a worker runs the same rules."
    },
    {
      "id": "plugins",
      "name": "Plugin issues",
      "trigger": "A comark-* plugin reports an issue while parsing",
      "steps": [
        "cmp:Config",
        "ext:Packages",
        "cmp:Lint",
        "shared:DocMeta"
      ],
      "summary": "Configured plugins parse the document; their meta.issues become diagnostics."
    },
    {
      "id": "typo",
      "name": "Catch a typo",
      "trigger": "::carosel instead of ::carousel",
      "steps": [
        "cmp:Lint",
        "cmp:RulesCore",
        "cmp:Words"
      ],
      "summary": "Unknown block, with the nearest known name from Levenshtein distance."
    }
  ],
  "notes": [
    {
      "title": "Positions are reconstructed, not read",
      "body": "Comark nodes have no positions: block components take a line from markdown-exit tokens, everything else is found by searching `prose` (source.ts:1) with code blanked, so columns still match.",
      "severity": "warn",
      "path": "packages/lint/src/source.ts"
    },
    {
      "title": "One catalog, 285 codes, four front ends",
      "body": "packages/lint/src/rules has 36 files and 285 `COMARKxx` entries; index.ts, cli.ts, doctor.ts and eslint.ts all read the same catalog, so a rule works everywhere at once.",
      "severity": "info",
      "path": "packages/lint/src/rules/index.ts"
    },
    {
      "title": "Packages are optional at runtime",
      "body": "config.ts imports each `comark-*/html` in a try/catch-esque promise chain and only uses what is installed; they are peer dependencies, so the linter installs no renderer itself.",
      "severity": "info",
      "path": "packages/lint/src/config.ts"
    },
    {
      "title": "index.ts carries the whole core",
      "body": "939 lines hold ~20 checks (unclosed blocks, unknown components, anchors, unsafe URLs, duplicate ids, alts, plugin issues) plus the locator mapping a node back to a line.",
      "severity": "warn",
      "path": "packages/lint/src/index.ts"
    },
    {
      "title": "Network checks never run in tests",
      "body": "packages/lint/test/links.test.ts:268 stubs globalThis.fetch for every URL test, so the suite is offline; --check-urls is the only path that really requests a host.",
      "severity": "info",
      "path": "packages/lint/test/links.test.ts"
    },
    {
      "title": "Every rule has a docs page with an example",
      "body": "docs/pages/doctor (48 pages) pairs ::incorrect and ::correct around one fence; test/doctor.test.ts fails when a rule lacks a page or when the wrong example reports more than its own code.",
