  "flows": [
    {
      "id": "mount",
      "name": "Client mounts",
      "trigger": "DSH loads the ds-bot client bundle",
      "steps": [
        "cmp:Client",
        "ipc:Slots",
        "cmp:Surface",
        "state:Roster",
        "ipc:ApiBot"
      ],
      "summary": "Slots are shadowed, the surface enters Bot mode, and state fills the roster."
    },
    {
      "id": "send",
      "name": "Send a message",
      "trigger": "Enter in the composer",
      "steps": [
        "cmd:Send",
        "ipc:ApiBot",
        "ipc:Feed",
        "cmp:Cells"
      ],
      "summary": "The POST starts the turn; stream events append cells as the reply arrives."
    },
    {
      "id": "create",
      "name": "Create a Bot",
      "trigger": "New Bot in the sidebar",
      "steps": [
        "cmd:NewBot",
        "cmp:CreateBot",
        "ipc:ApiBot",
        "state:Roster",
        "cmp:Sidebar"
      ],
      "summary": "The dialog posts create-bot; the returned state redraws the team."
    },
    {
      "id": "panel",
      "name": "Open a Bot's browser",
      "trigger": "Click the Bot tile's browser tab",
      "steps": [
        "cmd:OpenPanel",
        "cmp:Panel",
        "cmp:BotBrowsers",
        "ipc:AppBridge",
        "cmp:ReadPage"
      ],
      "summary": "The panel leases a webview, places it, and can read the page for the host."
    },
    {
      "id": "question",
      "name": "Answer a question card",
      "trigger": "Choose an option on a question card",
