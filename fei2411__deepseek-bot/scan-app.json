      "trigger": "A new release is published",
      "steps": [
        "cmp:Updates",
        "cmp:AppMain",
        "cmp:HostProcess"
      ],
      "summary": "Poll latest.yml, verify sha512, ask, stop the Host, run the installer."
    },
    {
      "id": "browser",
      "name": "Bot browser in the app",
      "trigger": "A Bot opens its browser panel",
      "steps": [
        "cmp:BotBrowser",
        "ipc:AppBridge",
        "cmp:AppMain",
        "cmp:BotViews"
      ],
      "summary": "A webview lease creates a partitioned view; the client places and reads it."
    },
    {
      "id": "cookies",
      "name": "Import cookies",
      "trigger": "Import cookies from a browser",
      "steps": [
        "cmp:BrowserSources",
        "cmp:CookieParse",
        "cmp:CookieImport",
        "cmp:BotBrowser"
      ],
      "summary": "A copy of the profile decrypts its own cookies; only a preview reaches the page."
    },
    {
      "id": "move",
      "name": "Move the data folder",
      "trigger": "Change location in settings",
      "steps": [
        "cmd:MoveData",
        "cmp:MoveData",
        "state:Locations",
        "cmp:HostProcess"
      ],
      "summary": "Copied beside the new folder, renamed when whole, then the Host restarts."
    }
  ],
  "notes": [
    {
      "title": "The shell follows DSH's desktop host",
      "body": "host-process.mjs, host.mjs, bot-browser.mjs and window-frame.mjs say they follow DeepSeek Harness apps/desktop (MIT) and NOTICE lists it, so upstream changes have a defined comparison point.",
      "severity": "info",
      "path": "NOTICE"
    },
    {
      "title": "Origin checks gate every IPC",
      "body": "main.mjs compares the Host's loopback origin on navigation and on every ds-bot: IPC sender; preload checks location.origin before exposing dsBotApp. No general ipcRenderer, fs or shell bridge.",
      "severity": "info",
      "path": "app/src/main.mjs"
    },
    {
      "title": "Secrets never reach the page",
      "body": "cookie-import.mjs keeps parsed cookies in main under a pending id and shows the renderer a value-free preview; applying writes them into the Bot partition, so values never reach the page.",
      "severity": "info",
      "path": "app/src/cookie-import.mjs"
    },
    {
      "title": "Two bundles are parked",
      "body": "engine/ and ui/ are the app's own window; README says both are on hold, not built or packaged, and profile.mjs retires deepseek-bot-engine from older profiles. ~1k lines ship nothing today.",
      "severity": "warn",
      "path": "app/README.md"
    },
    {
      "title": "main.mjs is the whole shell",
      "body": "613 lines hold startup, the 29-channel IPC table, window creation, Bot views, updates, data move, first run and failure pages; only the side concerns are split into modules.",
      "severity": "warn",
      "path": "app/src/main.mjs"
    }
  ]
}