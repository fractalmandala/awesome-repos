  "flows": [
    {
      "id": "load",
      "name": "Plugin loads in DSH",
      "trigger": "DSH starts with ds-bot enabled",
      "steps": [
        "cmp:PluginEntry",
        "ipc:Dsh",
        "cmp:Store",
        "cmp:Tools",
        "cmp:Channel"
      ],
      "summary": "Modules install in order; state loads; tools and /api/bot come up."
    },
    {
      "id": "send",
      "name": "Talk to a Bot",
      "trigger": "Type in the composer and press Enter",
      "steps": [
        "cmd:Send",
        "ipc:ApiBot",
        "cmp:Channel",
        "cmp:Delivery",
        "cmp:Turns",
        "ipc:Feed",
        "cmp:Cells"
      ],
      "summary": "The turn runs in the Bot's Session; the reply streams over the feed into cells."
    },
    {
      "id": "create-bot",
      "name": "Create a Bot",
      "trigger": "New Bot in the sidebar",
      "steps": [
        "cmd:NewBot",
        "ipc:ApiBot",
        "cmp:Tools",
        "cmp:Store",
        "cmp:Sidebar"
      ],
      "summary": "Roster entry plus a root Session; the sidebar shows the new tile."
    },
    {
      "id": "group",
      "name": "Group round",
      "trigger": "Send to a group chat",
      "steps": [
        "cmd:Send",
        "cmp:Groups",
        "cmp:Delivery",
        "cmp:Turns",
        "cmp:Cells"
      ],
      "summary": "Members speak in order, one turn each, until the relay limit pauses the room."
    },
    {
      "id": "handoff",
      "name": "Bot hands work over",
      "trigger": "message_bot from a Bot",
      "steps": [
        "cmp:Tools",
        "cmp:Turns",
        "cmp:Handoffs",
        "cmp:Delivery",
        "ipc:Feed"
      ],
      "summary": "The target Bot gets the message; its reply is routed back to the waiting turn."
    },
    {
      "id": "browser",
      "name": "Bot reads a page",
      "trigger": "read_browser in a Bot turn",
      "steps": [
        "cmp:Tools",
        "cmp:Browser",
        "cmp:BrowserPane",
        "ipc:AppBridge",
        "cmp:AppBrowser"
      ],
      "summary": "Host long-polls the window, the panel reads its webview, the text goes back."
    },
    {
      "id": "memory",
      "name": "A Bot remembers",
      "trigger": "remember called in a turn",
      "steps": [
        "cmp:Tools",
        "cmp:Memory",
        "state:MemoryFiles",
        "cmp:Memory"
      ],
      "summary": "Markdown entries and a journal line; the memory panel reads the same files."
    },
    {
      "id": "app-start",
      "name": "Start the desktop app",
      "trigger": "Open DeepSeek Bot",
      "steps": [
        "cmp:AppMain",
        "cmp:HostProcess",
        "ipc:HostBoot",
        "cmp:Profile",
        "cmp:PluginEntry",
        "cmp:ClientEntry"
      ],
      "summary": "Host boots the pinned DSH profile on loopback; the window loads it as DSH Web."
    }
  ],
  "notes": [
    {
      "title": "Module order is the contract",
      "body": "ds-bot/index.js:77 lists 35 host modules; listeners and tools run in registration order, so usage must stay last to meter every rewritten request. Adding a module means placing it in that list.",
      "severity": "info",
      "path": "ds-bot/index.js"
    },
    {
      "title": "One state.json, one writer",
      "body": "host/store.js keeps the whole team in DSH_HOME/bot/state.json, holds state.lock so a second host runs read-only, and treats ids from models and request bodies as untrusted (`own()` blocks __proto__).",
      "severity": "info",
      "path": "ds-bot/src/host/store.js"
    },
    {
      "title": "Two surfaces, one model",
      "body": "Every window draws the same team: the DSH slots path (client/index.js) and the parked app window (app/ui) both use src/client cells and the /api/bot channel plus the SSE feed.",
      "severity": "info",
      "path": "ds-bot/src/client/index.js"
    },
    {
      "title": "The app's own window is parked",
      "body": "app/README.md:128 and :130 mark app/engine and app/ui as \"on hold, not built or packaged\"; the shipped window loads DSH Web at the Host's loopback URL. ~1k lines of JS sit outside the release.",
      "severity": "warn",
      "path": "app/README.md"
    },
    {
      "title": "Tests are a rig, not a formality",
      "body": "110 unit files plus a scripted mock model (dev/mock-llm.mjs), a smoke bench, a stale-bundle check and a leak scan in CI (test.yml); Node 22/24 and two DSH versions run on every PR.",
      "severity": "info",
      "path": "ds-bot/dev/mock-llm.mjs"
    },
    {
      "title": "client.js is generated and committed",
      "body": "ds-bot/client.js is 1.1 MB built from src/client by esbuild; CI runs `build-client.mjs --check`, and AGENTS.md forbids editing it by hand. A client change is not complete until both are committed.",
      "severity": "info",
      "path": "ds-bot/client.js"
    }
  ]
}