  "flows": [
    {
      "id": "window",
      "name": "Create the window",
      "trigger": "app.whenReady()",
      "steps": [
        "cmp:Main",
        "cmp:Security",
        "ext:Electron",
        "ext:Renderer"
      ],
      "summary": "Menu, CSP and protocol first, then BrowserWindow loads the renderer URL."
    },
    {
      "id": "workspace",
      "name": "Open a workspace",
      "trigger": "Open workspace dialog",
      "steps": [
        "cmd:OpenWorkspaceDialog",
        "cmp:Workspace",
        "cmp:WorkspaceFiles",
        "cmp:WorkspaceIndexJob",
        "ipc:Workspace"
      ],
      "summary": "Canonical root, scan and index job, then a snapshot goes to the renderer."
    },
    {
      "id": "save",
      "name": "Save a document",
      "trigger": "renderer save request",
      "steps": [
        "ipc:Documents",
        "cmp:Document",
        "cmp:FileOperations",
        "cmp:History"
      ],
      "summary": "Guarded write through the operation lock, then a version is recorded."
    },
    {
      "id": "addon",
      "name": "Enable an addon",
      "trigger": "Enable in the Addon Garden",
      "steps": [
        "ipc:AddonChannels",
        "cmp:Addons",
        "cmp:AddonTrust",
        "cmp:AddonInventory"
      ],
      "summary": "Dependencies resolve, the package is validated, trust is read, then it loads."
    },
    {
      "id": "image",
      "name": "Read a document image",
      "trigger": "The editor requests a relative image",
      "steps": [
        "cmp:Main",
        "cmp:Images",
        "cmp:Security",
        "ext:Node"
      ],
      "summary": "Resolve from the document path, reject outside the root, cap at 8 MiB."
    },
    {
      "id": "diagnostics",
      "name": "Write diagnostics",
      "trigger": "A renderer diagnostic event",
      "steps": [
        "ipc:Diagnostics",
        "cmp:Diagnostics",
        "state:DiagnosticBudget"
      ],
      "summary": "Bounded queue, redaction, atomic rotating file in userData."
    }
  ],
  "notes": [
    {
      "title": "One guard, 130 channels",
      "body": "`handle()` (index.ts:1340) wraps every registration with trustedWindow and optional benchmark hooks; 130 call sites use it, so a new channel inherits the sender and URL check.",
      "severity": "info",
      "path": "src/main/index.ts"
    },
    {
      "title": "index.ts carries window, menu and routing",
      "body": "2,439 lines: createWindow (849), installMenu (1131) and the channel table. A change to any of the three edits the same file.",
      "severity": "warn",
      "path": "src/main/index.ts"
    },
    {
      "title": "Workspace I/O is split by concern",
      "body": "workspace.ts owns the root and snapshots, workspace-files.ts reads and writes, workspace-change-stream.ts watches, workspace-index-job.ts keeps the newest index.",
      "severity": "info",
      "path": "src/main/workspace.ts"
    },
    {
      "title": "Trust and inventory are separate steps",
      "body": "addon-inventory.ts unzips with crc32 and bounded sizes; addon-trust.ts decides whether the signature is acceptable. Neither imports the other's policy, which makes the trust gate auditable on its own.",
      "severity": "info",
      "path": "src/main/addon-trust.ts"
    },
    {
      "title": "Document writes share an operation lock",
      "body": "file-operation-dialog.ts guards document replacement, export and addon preference writes; closing the app waits for the active operation and checks unsaved edits.",
      "severity": "info",
      "path": "src/main/file-operation-dialog.ts"
    },
    {
      "title": "The menu dispatches instead of acting",
      "body": "installMenu sends `app:command` with an AppCommand id (hotkeys.ts) rather than calling functions, so the renderer owns behaviour and the menu stays a thin surface.",
      "severity": "info",
      "path": "src/main/index.ts"
    }
  ]
}