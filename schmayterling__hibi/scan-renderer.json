  "flows": [
    {
      "id": "mount",
      "name": "Mount the app",
      "trigger": "index.html loads main.tsx",
      "steps": [
        "cmp:App",
        "ext:Main",
        "ipc:Workspace",
        "state:Documents"
      ],
      "summary": "Bootstrap state arrives, then tabs and the last document are restored."
    },
    {
      "id": "open",
      "name": "Open a document",
      "trigger": "Click a row in the sidebar",
      "steps": [
        "cmp:WorkspaceSidebar",
        "cmp:App",
        "ipc:Documents",
        "cmp:DocumentRuntime",
        "cmp:Editor"
      ],
      "summary": "Main returns text and journal; a runtime is created per document id."
    },
    {
      "id": "type",
      "name": "Type",
      "trigger": "A keystroke in the rich editor",
      "steps": [
        "cmp:Editor",
        "cmp:PlainSourceSync",
        "shared:SourceEngine",
        "cmp:DocumentRuntime"
      ],
      "summary": "ProseMirror steps become source operations; the document turns dirty."
    },
    {
      "id": "source",
      "name": "Switch to source",
      "trigger": "Ctrl+Shift+]",
      "steps": [
        "cmd:SourceView",
        "cmp:MarkdownSource",
        "cmp:SourceEditor",
        "shared:SourceEngine"
      ],
      "summary": "CodeMirror binds to the same source snapshot, so the text is already current."
    },
    {
      "id": "save",
      "name": "Save",
      "trigger": "Ctrl+S",
      "steps": [
        "cmd:Save",
        "cmp:DocumentRuntime",
        "ipc:Documents"
      ],
      "summary": "Dirty documents take one guarded save path, then external-change stamps update."
    },
    {
      "id": "find",
      "name": "Find",
      "trigger": "Ctrl+F",
      "steps": [
        "cmd:Find",
        "cmp:FindBar",
        "cmp:WorkerClient",
        "cmp:Editor"
      ],
      "summary": "The worker searches the snapshot; the bar reveals hits in the active view."
    },
    {
      "id": "addon",
      "name": "Install an addon",
      "trigger": "Install in the Addon Garden",
      "steps": [
        "cmp:AddonGarden",
        "cmp:AddonHost",
        "ipc:AddonChannels",
