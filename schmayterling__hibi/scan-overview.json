  "flows": [
    {
      "id": "launch",
      "name": "Launch",
      "trigger": "Starting hibi",
      "steps": [
        "cmp:Main",
        "cmp:Preload",
        "cmp:RendererRoot",
        "ipc:Bootstrap",
        "state:WorkspaceState"
      ],
      "summary": "Main opens the window; preload exposes named calls; the renderer bootstraps."
    },
    {
      "id": "workspace",
      "name": "Open a workspace",
      "trigger": "Ctrl+Shift+O",
      "steps": [
        "cmd:OpenWorkspace",
        "cmp:WorkspaceMain",
        "ipc:Workspace",
        "cmp:Sidebar"
      ],
      "summary": "Folder dialog, canonical scan and index, then the tree is handed to the sidebar."
    },
    {
      "id": "open-doc",
      "name": "Open a note",
      "trigger": "Click a file in the sidebar",
      "steps": [
        "cmp:Sidebar",
        "cmp:RendererRoot",
        "ipc:Documents",
        "cmp:DocumentMain",
        "cmp:Editor"
      ],
      "summary": "Renderer asks for the document; main reads and journals it; the editor loads."
    },
    {
      "id": "type",
      "name": "Type and autosave",
      "trigger": "A keystroke in the rich editor",
      "steps": [
        "cmp:Editor",
        "cmp:DocumentRuntime",
        "cmp:DocumentSession",
        "ipc:Documents",
        "cmp:DocumentMain"
      ],
      "summary": "Edits reach the shared session, the runtime marks dirty, save goes through IPC."
    },
    {
      "id": "source",
      "name": "Switch to source",
      "trigger": "Ctrl+Shift+]",
      "steps": [
        "cmd:SourceView",
        "cmp:SourceEditor",
        "cmp:DocumentSession",
        "cmp:MarkdownSemantics"
      ],
      "summary": "The same source model drives CodeMirror, so both views edit one buffer."
    },
    {
      "id": "addon",
      "name": "Install an addon",
      "trigger": "Install addon from the palette",
      "steps": [
        "cmd:InstallAddon",
        "cmp:AddonHostRenderer",
        "cmp:AddonInventory",
        "cmp:AddonTrust",
        "cmp:AddonHostMain"
      ],
      "summary": "Unzipped and validated, signature checked, then enabled for the renderer."
    },
    {
      "id": "find",
      "name": "Find in the document",
      "trigger": "Ctrl+F",
      "steps": [
        "cmd:Find",
        "cmp:SearchIndex",
        "cmp:SourceEngine",
        "cmp:Editor"
      ],
      "summary": "Literal search runs over source snapshots; the active view reveals the hits."
    },
    {
      "id": "export",
      "name": "Export a site",
      "trigger": "Export site from the documentation addon",
      "steps": [
        "cmd:ExportSite",
        "cmp:BundledAddons",
        "cmp:SiteViewer"
      ],
      "summary": "The documentation addon writes static pages; the site viewer is the same UI."
    }
  ],
  "notes": [
    {
      "title": "Two 3k-line files hold the app shell",
      "body": "src/renderer/src/main.tsx is 3,315 lines (one App component with tabs, dialogs, sidebars, hotkeys) and Editor.tsx 3,367. Everything the shell does is reachable from those two files.",
      "severity": "warn",
      "path": "src/renderer/src/main.tsx"
    },
    {
      "title": "One guarded gate for 130 IPC channels",
      "body": "src/main/index.ts registers every channel through a local `handle()` (line 1340) that calls `trustedWindow(...)` first and can inject benchmark timing; 130 channels share that one check.",
      "severity": "info",
      "path": "src/main/index.ts"
    },
    {
      "title": "Rich and source views share one model",
      "body": "TipTap (Editor.tsx) and CodeMirror (SourceEditor.tsx) both edit the `SourceStore` from src/shared/source-buffer.ts; plain-source-sync.ts keeps positions mapped, so a switch does not lose edits.",
      "severity": "info",
      "path": "src/shared/source-buffer.ts"
    },
    {
      "title": "42 addons, one versioned contract",
      "body": "ADDON_API_VERSION = 2 in src/addons/api.ts, with capabilities ui, rich, source, markdown and modalEditing; each addon ships index.tsx, manifest.ts and hibi-addon.json.",
      "severity": "info",
      "path": "src/addons/api.ts"
    },
    {
      "title": "docs/ is a generated snapshot",
      "body": ".gitignore ignores /docs except ai-agents and licenses; docs-revision pins a commit and `npm run docs` regenerates API pages from declarations, so reading guides offline needs that step.",
      "severity": "info",
      "path": ".gitignore"
    },
    {
      "title": "The test suite dwarfs the app",
      "body": "346 test files and 105,327 lines against 102,730 lines of src; CI runs them on 3 operating systems × 4 shards (.github/workflows/check.yml).",
      "severity": "info",
      "path": "tests"
    }
  ]
}