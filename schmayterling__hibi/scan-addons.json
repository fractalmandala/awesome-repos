  "flows": [
    {
      "id": "load",
      "name": "Load the enabled addons",
      "trigger": "The renderer starts",
      "steps": [
        "ext:Host",
        "cmp:Api",
        "state:AddonStorage",
        "shared:Manifest"
      ],
      "summary": "Manifests are checked for API v2, enabled addons import, each gets its APIs."
    },
    {
      "id": "command",
      "name": "Run an addon command",
      "trigger": "Picking an addon command in the palette",
      "steps": [
        "cmd:AddonCommand",
        "ext:Host",
        "cmp:Api"
      ],
      "summary": "Commands are prefixed with the addon id and filtered by their `when` context."
    },
    {
      "id": "spell",
      "name": "Look a word up",
      "trigger": "Hovering a misspelled word",
      "steps": [
        "cmp:Dictionary",
        "cmp:DictionaryPacks",
        "ipc:HostNetwork"
      ],
      "summary": "Offline packs answer first; the online provider is asked only when allowed."
    },
    {
      "id": "complete",
      "name": "Accept a completion",
      "trigger": "Typing a word with suggestions",
      "steps": [
        "ext:Host",
        "cmp:Autocomplete",
        "cmp:AutocompleteModel"
      ],
      "summary": "The broker asks the autocomplete provider; the accepted word is learned locally."
    },
    {
      "id": "export",
      "name": "Export a site",
      "trigger": "Export site from the palette",
      "steps": [
        "cmd:ExportSite",
        "cmp:Documentation",
        "cmp:Formats"
      ],
      "summary": "Pages and assets are rendered through the shared format pipeline."
    },
    {
      "id": "mcp",
      "name": "Let an agent edit",
      "trigger": "An MCP client calls edit_document",
      "steps": [
        "cmp:McpServer",
        "cmp:McpTools",
        "state:Preferences"
      ],
      "summary": "The tool plans edits against open tabs and returns them as unsaved changes."
    }
  ],
  "notes": [
    {
      "title": "Capabilities gate what an addon can touch",
      "body": "AddonCapability (api.ts:110) is ui, rich, source, markdown or modalEditing; vim claims the single modalEditing slot, quick-note the ui window. The host decides from the manifest before code loads.",
      "severity": "info",
      "path": "src/addons/api.ts"
    },
    {
      "title": "42 addons, one file layout",
      "body": "Every folder has hibi-addon.json, manifest.ts and an index, plus optional Settings.tsx, native.ts and preferences.ts. scripts/addon-packages.ts builds them, so the shape is mechanical.",
      "severity": "info",
      "path": "src/addons/markdown/manifest.ts"
    },
    {
      "title": "The addon directory is not the code path",
      "body": "Installed addons are imported by the renderer from the build catalog (virtual:hibi-addon-catalog), and main validates packages in addon-inventory.ts; a workspace is never treated as addon code.",
      "severity": "info",
      "path": "src/main/addon-inventory.ts"
    },
    {
      "title": "Two addons carry most of the weight",
      "body": "dictionary is 5,202 lines and autocomplete 1,686, together a quarter of src/addons. Dictionary alone has 30 files: packs, converters, providers, workers, side view.",
      "severity": "warn",
      "path": "src/addons/dictionary"
    },
    {
      "title": "Addon UI is first-class",
      "body": "Addons contribute panels (tags, graph, git), settings screens, toolbar items, editor decorations and whole windows (quick-note, mcp settings), not just parsers.",
      "severity": "info",
      "path": "src/addons/quick-note/index.tsx"
    },
    {
      "title": "Shared format pipeline",
      "body": "_shared/format-specs.ts and format-worker.ts give every document-type addon (md, typst, html, rst, org, asciidoc…) one export/preview path instead of one per addon.",
      "severity": "info",
      "path": "src/addons/_shared/format-specs.ts"
    }
  ]
}