  "flows": [
    {
      "id": "edit",
      "name": "Apply an edit",
      "trigger": "An editor sends a SourceOperation",
      "steps": [
        "cmp:DocumentSession",
        "cmp:SourceOperations",
        "cmp:SourceStore",
        "state:Snapshots"
      ],
      "summary": "Validated against the pre-state, applied to the tree, a new snapshot published."
    },
    {
      "id": "history",
      "name": "Undo one gesture",
      "trigger": "Undo after a burst of edits",
      "steps": [
        "state:History",
        "cmp:DocumentSession",
        "cmp:SourceStore"
      ],
      "summary": "One group holds forward and inverse edits, so a gesture undoes in one step."
    },
    {
      "id": "find",
      "name": "Find in a document",
      "trigger": "A find request from the bar",
      "steps": [
        "ipc:Worker",
        "cmp:WorkerService",
        "cmp:SourceSearchIndex",
        "cmp:SourceSearch"
      ],
      "summary": "The worker searches its own store; replies carry versions so stale results drop."
    },
    {
      "id": "semantics",
      "name": "Reparse a changed region",
      "trigger": "A snapshot changes",
      "steps": [
        "cmp:WorkerService",
        "cmp:MarkdownSemanticCache",
        "cmp:MarkdownModel"
      ],
      "summary": "Only the damaged region is retokenised, bounded by the cache budget."
    },
    {
      "id": "journal",
      "name": "Recover after a crash",
      "trigger": "The app restarts with a journal",
      "steps": [
        "cmp:DocumentJournal",
        "cmp:DocumentCheckpoint",
        "cmp:DocumentSession"
      ],
      "summary": "The checkpoint is verified, operations replayed, then a session takes the store."
    },
    {
      "id": "bootstrap",
      "name": "Bootstrap the renderer",
      "trigger": "App start",
      "steps": [
        "cmp:Desktop",
        "cmp:Contracts",
        "shared:Renderer"
      ],
      "summary": "Channel names and the DesktopApi type are the only contract the two sides share."
    }
  ],
  "notes": [
    {
      "title": "The text engine is the centre of gravity",
      "body": "source-buffer.ts (1,085), source-owners.ts (695) and document-session.ts (634) implement a chunk tree with subtree sums, immutable snapshots and owner ranges; editors, search and journal sit on it.",
      "severity": "info",
      "path": "src/shared/source-buffer.ts"
    },
    {
      "title": "Coordinates are UTF-16 pre-state, deliberately",
      "body": "source-operations.ts defines RawEdit in the immutable pre-state and validates each operation before applying; the test suite includes a 100k-line prefix-edit case to keep that bounded.",
      "severity": "info",
      "path": "src/shared/source-operations.ts"
    },
    {
      "title": "The worker gets a whole store, not chunks",
      "body": "document-worker-protocol.ts sends load/edit/find with an epoch and version, and document-worker-service.ts keeps its own SourceStore, so searching never blocks the UI thread.",
      "severity": "info",
      "path": "src/shared/document-worker-protocol.ts"
    },
    {
      "title": "Contracts are one directory both sides import",
      "body": "desktop.ts holds channel names and DesktopApi, foundation-contracts.ts ids and targets, addon-manifest.ts the manifest schema; main, preload, renderer and addons import these, not each other.",
      "severity": "info",
      "path": "src/shared/desktop.ts"
    },
    {
      "title": "Diagnostics never carry document text",
      "body": "local-diagnostics.ts states it accepts no free-form metadata or document identifiers; profiles bound frames and budgets, and the queue is shared with the main sink.",
      "severity": "info",
      "path": "src/shared/local-diagnostics.ts"
    }
  ]
}