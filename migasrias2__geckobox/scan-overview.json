    {
      "id": "start-agent-job",
      "name": "Start an agent job",
      "trigger": "openspaces start \"prompt\"",
      "steps": [
        "cmd:StartCmd",
        "cmp:ThreadModule",
        "ipc:Transport",
        "ext:ClaudeCLI",
        "state:Store"
      ],
      "summary": "Turn script runs on the chosen computer in a detached worker."
    },
    {
      "id": "monitor-jobs",
      "name": "Watch jobs in the dashboard",
      "trigger": "dashboard polls every 1.5s",
      "steps": [
        "cmp:AppTSX",
        "ipc:RestApi",
        "cmp:Routes",
        "state:Store",
        "cmp:ThreadModule"
      ],
      "summary": "Incremental /api/threads/:id?after= event feed."
    },
    {
      "id": "live-screen",
      "name": "Watch a live screen",
      "trigger": "pin a computer's live pane in the UI",
      "steps": [
        "cmp:AppTSX",
        "cmp:UiComponents",
        "ipc:RaylibScreen",
        "state:ScreenHub",
        "cmp:ScreenCapture"
      ],
      "summary": "Long-poll frames throttled per computer with idle stop."
    },
    {
      "id": "fan-out",
      "name": "Fan out one job",
      "trigger": "openspaces run --on a,b,c",
      "steps": [
        "cmd:RunCmd",
        "cmd:StartCmd",
        "cmp:ThreadModule",
        "ipc:Transport"
      ],
      "summary": "Run a job on every named computer in parallel."
    },
    {
      "id": "sandbox-workspace",
      "name": "Create a sandbox",
      "trigger": "openspaces sandbox create <name>",
      "steps": [
        "cmd:SandboxCmd",
        "cmp:SandboxModule",
        "ext:Containers"
      ],
      "summary": "Apple container/Docker/Podman Linux box with agents installed."
    },
    {
      "id": "desktop-takeover",
      "name": "Take over a desktop",
      "trigger": "openspaces view <computer>",
      "steps": [
        "cmd:ViewCmd",
        "cmp:ViewModule",
        "ipc:VncTunnel"
      ],
      "summary": "SSH tunnel to VNC 5900, then open the viewer \u2014 no relay."
    }
  ],
  "notes": [
    {
      "title": "tiny, disciplined core",
      "body": "58 TS files, ~6k LOC total (src 1,693 + server/cli/agents modules + UI; 12 test files); only runtime dep is zod.",
