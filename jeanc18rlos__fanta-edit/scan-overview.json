  "flows": [
    {
      "id": "open-project",
      "name": "Open a Fanta project",
      "trigger": "open folder / fanta.json on the command line",
      "steps": [
        "cmp:FantaEntry",
        "cmp:Workspace",
        "cmp:FigViewer",
        "state:Doc",
        "cmp:RenderEngine"
      ],
      "summary": "workspace_hooks observes the worktree and opens the canvas tab; Metal renders."
    },
    {
      "id": "import-fig",
      "name": "Import a .fig file",
      "trigger": "open a .fig initially or import into a project",
      "steps": [
        "cmp:FigInterop",
        "cmp:EngineDoc",
        "cmp:FigViewer",
        "state:Doc"
      ],
      "summary": "Kiwi-decoded fig tree maps into the Fanta scene, then renders editable."
    },
    {
      "id": "canvas-edit",
      "name": "Edit on canvas",
      "trigger": "select + keybind or keydown gesture",
      "steps": [
        "state:FigView",
        "state:Doc",
        "ipc:FnxIO",
        "cmp:Format"
      ],
      "summary": "Canvas ops mutate the doc; debounced FNX saves are diffable."
    },
    {
      "id": "external-agent",
      "name": "Agent edits the design",
      "trigger": "client connects to the live MCP socket",
      "steps": [
        "ipc:LiveMcp",
        "shared:DesignSurface",
        "state:Doc",
        "state:FigView"
      ],
      "summary": "External agents share built-in design_surface ops; canvas live."
    },
    {
      "id": "agent-tools",
      "name": "Built-in agent designs",
      "trigger": "task prompts the design tools in the agent panel",
      "steps": [
        "cmp:AgentUI",
        "ipc:BuiltinAgents",
        "state:Doc",
        "ipc:FnxIO"
      ],
      "summary": "Provider-backed design ops apply and persist identical to human edits."
    },
    {
      "id": "zoom-fit-tools",
      "name": "Zoom / tools on canvas",
      "trigger": "cmd+plus / wheel or palette entry",
      "steps": [
        "cmd:ZoomFit",
        "state:FigView",
        "cmp:RenderEngine"
      ],
      "summary": "Camera changes re-render the scene without touching the document."
    }
  ],
