  "flows": [
    {
      "id": "new-design",
      "name": "Create a design",
      "trigger": "New Design action",
      "steps": [
        "cmd:NewDesign",
        "cmp:WorkspaceHooks",
        "state:FigViewEntity",
        "state:DocEntity",
        "ipc:FnxWrites"
      ],
      "summary": "Creates a project folder, opens the canvas, saves FNX."
    },
    {
      "id": "open-fig",
      "name": "Import a .fig",
      "trigger": "open a .fig file in the workspace",
      "steps": [
        "ext:FigInterop",
        "state:DocEntity",
        "state:FigViewEntity",
        "ext:Render"
      ],
      "summary": "fig tree maps to the scene then paints on the canvas."
    },
    {
      "id": "canvas-gesture",
      "name": "Select / move layers",
      "trigger": "click or drag on the canvas",
      "steps": [
        "state:FigViewEntity",
        "cmd:SelectionOps",
        "state:DocEntity",
        "ipc:FnxWrites"
      ],
      "summary": "Gestures publish doc ops; undo map persists; FNX writes."
    },
    {
      "id": "layers-panel",
      "name": "Reorder in Layers panel",
      "trigger": "drag a row in the design panel",
      "steps": [
        "cmp:DesignPanel",
        "state:DocEntity",
        "state:FigViewEntity"
      ],
      "summary": "Drop placement rules re-parent items with cycle guards."
    },
    {
      "id": "prototype-run",
      "name": "Play the prototype",
      "trigger": "PlayPrototype action",
      "steps": [
        "cmd:PlayPrototype",
        "cmp:PrototypePlayer",
        "cmp:MotionStage",
        "cmp:Timeline"
      ],
      "summary": "Presents from start frame; motion stage and timeline animate."
    },
    {
      "id": "external-agent-edits",
      "name": "External agent edits canvas",
      "trigger": "client connects to MCP socket",
      "steps": [
        "ipc:LiveMcpSock",
        "state:Registration",
        "state:DocEntity",
        "state:FigViewEntity",
        "ipc:ScreensMedia"
      ],
      "summary": "Codex/Claude Code apply ops and screenshot via the same surface."
    },
    {
      "id": "code-edit",
      "name": "Edit design as code",
      "trigger": "edit FNX text in the code view",
      "steps": [
        "cmp:CodeWorkspace",
        "state:DocEntity",
        "state:FigViewEntity",
        "ext:Format"
      ],
      "summary": "Text edits morph the live canvas and write back to files."
    }
  ],
