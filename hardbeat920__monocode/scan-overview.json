  "flows": [
    {
      "id": "start-session",
      "name": "Send a message",
      "trigger": "composer enter",
      "steps": [
        "cmd:ComposerMsg",
        "shared:HarnessCore",
        "ipc:TauriCommands",
        "ext:AgentCli"
      ],
      "summary": "Command appears in the transcript tab; streamed by provider CLI."
    },
    {
      "id": "watch-stream",
      "name": "Watch the transcript",
      "trigger": "harness delta events",
      "steps": [
        "shared:HarnessCore",
        "cmp:Integrations",
        "cmp:Sessions",
        "state:SessionStore"
      ],
      "summary": "Batches message.delta into AgentTranscript with approvals/ordering."
    },
    {
      "id": "monos-task",
      "name": "/operator a task",
      "trigger": "start a message with /operator",
      "steps": [
        "cmd:OperatorCmd",
        "cmp:Monos",
        "state:SessionStore",
        "ipc:TauriCommands"
      ],
      "summary": "Opening sessions and git worktrees/notes; scheduling stays on monos."
    },
    {
      "id": "files-and-review",
      "name": "Edit and review files",
      "trigger": "select a file in the file tree",
      "steps": [
        "cmp:Files",
        "ipc:TauriCommands",
        "cmp:SourceControl",
        "ext:Git"
      ],
      "summary": "Read/write via fs.rs; diffs arrive from git through tauri commands."
    },
    {
      "id": "remote-link",
      "name": "Pair a phone",
      "trigger": "mobile link from settings",
      "steps": [
        "cmd:MobileLink",
        "ipc:MobileLinkCrate",
        "ipc:HostServer",
        "ipc:MobileApp"
      ],
      "summary": "Phone pairs with host service to steer sessions remotely."
    },
    {
      "id": "mobile-drive",
      "name": "Mobile drives sessions",
      "trigger": "send from the mobile app",
      "steps": [
        "ipc:MobileApp",
        "ipc:HostServer",
        "ipc:HostEngine",
        "ext:AgentCli"
      ],
      "summary": "Host runs the same harness protocol and flushes streamed batches."
    }
  ],
  "notes": [
    {
      "title": "three backends, one protocol",
      "body": "The same harness/core protocol is driven by the Tauri process (spawn) and by the Node host service for remote/mobile (host/engine.ts).",
