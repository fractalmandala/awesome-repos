  "notes": [
    {
      "title": "No URL sync; browser Back leaves the app",
      "body": "location.hash is read once at boot (main.js:70); go() only writes S.ui.route and a private history array. No pushState, no hashchange, no popstate, so refresh returns to prefs.home.",
      "severity": "warn",
      "path": "src/shell/render.js"
    },
    {
      "title": "Focus, caret and scroll are restored by hand",
      "body": "render() records document.activeElement as a stable CSS key (FKEYS), selectionStart/End and every [data-keep] scrollTop before replacing innerHTML, then puts them back.",
      "severity": "info",
      "path": "src/shell/render.js"
    },
    {
      "title": "Every route is imported eagerly",
      "body": "layout.js statically imports every page, view and feature module for its 21-entry route table, so Vite emits one 358 kB JS chunk. No lazy() anywhere.",
      "severity": "info",
      "path": "src/shell/layout.js"
    },
    {
      "title": "A circular import chain depends on hoisting",
      "body": "render.js → layout.js → pages/settings.js → overlays/modals.js → render.js, with drawer/palette loops too. It works only because every use sits inside a function called later.",
      "severity": "warn",
      "path": "src/shell/render.js"
    },
    {
      "title": "View state is created lazily per key",
      "body": "viewOf(key) seeds S.views[key] with filters, sort, group, hidden columns and width, then persists it. Keys are 'tasks', 'mytasks', 'p:<project>' and 'sv:<savedView>'.",
      "severity": "info",
      "path": "src/shell/view-engine.js"
    }
  ]
