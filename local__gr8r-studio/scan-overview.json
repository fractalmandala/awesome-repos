  "flows": [
    {
      "id": "boot",
      "name": "Boot the saved workspace",
      "trigger": "Open the app",
      "steps": [
        "cmp:Main",
        "state:Store",
        "ipc:LocalStorage",
        "state:SeedData",
        "cmp:Router",
        "cmp:Shell",
        "cmp:HomePage"
      ],
      "summary": "Store loads gr8r.v2 or seeds demo data, then the router renders Home."
    },
    {
      "id": "palette",
      "name": "Jump with the palette",
      "trigger": "⌘K / Ctrl K",
      "steps": [
        "cmd:OpenPalette",
        "state:Store",
        "cmp:Router",
        "cmp:Palette",
        "cmp:SearchPage"
      ],
      "summary": "Palette opens in command mode; Tab searches, Enter runs, results page follows."
    },
    {
      "id": "create-task",
      "name": "Create a task from a board",
      "trigger": "New task / N",
      "steps": [
        "cmd:NewTask",
        "cmp:Modals",
        "state:Store",
        "ipc:LocalStorage",
        "cmp:Router",
        "cmp:BoardView"
      ],
      "summary": "Modal form creates the task, logs activity, saves and re-renders the board."
    },
    {
      "id": "move-card",
      "name": "Move a card to another column",
      "trigger": "Drag a board card",
      "steps": [
        "cmd:DragCard",
        "state:Store",
        "ipc:LocalStorage",
        "cmp:Router",
        "cmp:BoardView"
      ],
      "summary": "Drop rewrites status and fractional order, toasts, then redraws."
    },
    {
      "id": "save-view",
      "name": "Save a filtered view as a tab",
      "trigger": "Save view + in the project tabs",
      "steps": [
        "cmp:ViewEngine",
        "cmd:SaveView",
        "cmp:Modals",
        "state:Store",
        "cmd:GoRoute",
        "cmp:ProjectPage"
      ],
      "summary": "Filters are copied into D().savedViews and opened as a v:<id> tab."
    },
    {
      "id": "sign-in",
      "name": "Sign in and land on Home",
      "trigger": "Sign in button",
      "steps": [
        "cmp:AuthPage",
        "cmd:SignIn",
        "state:Store",
        "cmd:GoRoute",
        "cmp:Shell",
        "cmp:HomePage"
      ],
      "summary": "Client-side validation, fake delay, then enterApp routes to prefs.home."
    },
    {
      "id": "upload",
      "name": "Attach a file to a task",
      "trigger": "Drop a file on the task drawer",
      "steps": [
        "cmp:Drawer",
        "ipc:Upload",
        "state:Store",
        "ipc:LocalStorage",
        "cmp:FilesView"
      ],
      "summary": "Simulated progress writes a file record, attaches it and lists it."
    }
  ],
  "notes": [
    {
      "title": "actions.js is 2,293 lines and owns everything",
      "body": "182 A handlers, 36 IN, 7 KEY plus forms, auth, settings and prototype controls in one file: 26% of app JS. Domain splits (tasks, projects, account) are absent.",
      "severity": "alert",
      "path": "src/actions/actions.js"
    },
    {
      "title": "Every keystroke rebuilds the whole app",
      "body": "render() replaces #app.innerHTML and #layer.innerHTML; IN.palQ, IN.viewQ, IN.searchQ and IN.draft call it on input. Focus, caret and scroll are restored by hand across 176 render() sites.",
      "severity": "warn",
      "path": "src/shell/render.js"
    },
    {
      "title": "Task descriptions are stored and injected raw",
      "body": "actions.js:928 and :937 assign contenteditable innerHTML to t.desc; drawer.js:91 interpolates it unescaped. Pasted markup runs on the next render. Everything else goes through esc().",
      "severity": "warn",
      "path": "src/actions/actions.js"
    },
    {
      "title": "Global store is the only coupling point",
      "body": "45 of the 52 JS files import core/store.js; S.ui carries 43 flags and any module may mutate them. No selectors, no events, one debounced JSON blob in localStorage.",
      "severity": "info",
      "path": "src/core/store.js"
    },
    {
      "title": "No tests; CI only lints, formats and builds",
      "body": ".github/workflows/ci.yml runs npm ci, lint, format:check and vite build. Zero test files, no test script, no assertions anywhere in the repo.",
      "severity": "warn",
      "path": ".github/workflows/ci.yml"
    },
    {
      "title": "Saved views keep filters, not sort or grouping",
      "body": "saveViewSubmit copies viewOf(key).filters only; sort, group and hidden columns reset. The view then renders as a plain list or board tab.",
      "severity": "info",
      "path": "src/actions/actions.js"
    }
  ]
}
