  "notes": [
    {
      "title": "2,293 lines, 182 handlers, one file",
      "body": "A/IN/KEY/DBL/BLUR live in actions.js and cover tasks, projects, sharing, members, notifications, settings, auth and prototype tools. 422 data-a sites reference it.",
      "severity": "alert",
      "path": "src/actions/actions.js"
    },
    {
      "title": "The action table has no schema",
      "body": "events.js does const fn = A[el.dataset.a]; if (fn) fn(el, e). A renamed or misspelled data-a attribute silently does nothing: no warning, no type, no test.",
      "severity": "warn",
      "path": "src/actions/events.js"
    },
    {
      "title": "mutate() is the one choke point",
      "body": "ui/toast.js mutate(fn) guards S.ui.offline, runs the write, debounces save() and calls render(). Worth copying: most writes cannot forget to persist.",
      "severity": "info",
      "path": "src/ui/toast.js"
    },
    {
      "title": "Form submits read the DOM back into state",
      "body": "submitTask reads $('#f-title').value and $('#f-desc').value, then patches S.ui.form. Values from unmounted fields fall back to state, so the source of truth alternates.",
      "severity": "info",
      "path": "src/actions/actions.js"
    }
  ]
}
