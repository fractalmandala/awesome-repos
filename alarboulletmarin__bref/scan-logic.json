  "flows": [
    {
      "id": "list-enter",
      "name": "Continue a list",
      "trigger": "Enter at the end of a `- ` line",
      "steps": [
        "cmp:Lists",
        "cmp:Markdown"
      ],
      "summary": "Picks the next marker, renumbers ordered lists, keeps indentation."
    },
    {
      "id": "cell-formula",
      "name": "Evaluate a cell",
      "trigger": "Type =B*C in a table cell",
      "steps": [
        "cmp:Formula",
        "cmp:Table"
      ],
      "summary": "Columns are letters, rows counted under the header; cycles are detected."
    },
    {
      "id": "embed-lookup",
      "name": "Resolve an embed",
      "trigger": "Type ![[Note#Heading]] alone",
      "steps": [
        "cmp:Embed",
        "cmp:Markdown"
      ],
      "summary": "Finds the heading and what is under it up to the next same-level heading."
    },
    {
      "id": "mermaid-import",
      "name": "Mermaid to canvas",
      "trigger": "Paste a Mermaid class diagram",
      "steps": [
        "cmp:Mermaid",
        "cmp:Diagram",
        "cmp:Uml",
        "cmp:Relation"
      ],
      "summary": "Classes, members, relations become shapes and arrows; the rest is skipped."
    },
    {
      "id": "save-diagram",
      "name": "Save a moved shape",
      "trigger": "Drag a shape on the canvas",
      "steps": [
        "cmp:Diagram",
        "cmp:DiagramRoute",
        "cmp:DiagramFile"
      ],
      "summary": "Arrows re-route around obstacles, then SVG and metadata source are rewritten."
    },
    {
      "id": "paste-table",
      "name": "Paste a spreadsheet",
      "trigger": "Paste TSV onto a Markdown table",
      "steps": [
        "cmp:MdTables",
        "cmp:Markdown",
        "cmp:Block"
      ],
      "summary": "Rows and columns are widened to fit, alignment row kept, block range updated."
    },
    {
      "id": "rename-heading",
      "name": "Rename a heading",
      "trigger": "Rename a heading in a note",
      "steps": [
        "cmp:Embed",
        "cmp:Markdown"
      ],
      "summary": "Rewrites `#Heading` anchors in the notes that embed or link to it."
    },
    {
      "id": "empty-page",
      "name": "Empty page",
      "trigger": "Open a new empty note",
      "steps": [
        "cmp:Recall",
        "cmp:Dates",
        "state:Note"
      ],
      "summary": "Daily notes of a week/month/year ago plus one note untouched for a month."
    }
  ],
  "notes": [
    {
      "title": "The layer is pure and stays pure",
      "body": "No file under src/logic imports gpui, the disk or a view; `layers_only_depend_downwards` (src/shell/tests/mod.rs:25) fails the build otherwise. 13.2k lines, unit-tested inline.",
      "severity": "info",
      "path": "src/logic/mod.rs"
    },
    {
      "title": "markdown/mod.rs is a 1.7k-line toolbox",
      "body": "29 public functions in one file (classify, emphasis, links, comments, headings, index, relink) plus 23 `unwrap`/`expect` and 400+ lines of tests. Most views import it directly.",
      "severity": "warn",
      "path": "src/logic/markdown/mod.rs"
    },
    {
      "title": "Diagram files are versioned SVG + source",
      "body": "`VERSION = 10` (diagram/mod.rs:52). A file is written with `Diagram::needed`, the lowest version that says what it holds, so older builds still open it; newer files open read-only.",
      "severity": "info",
      "path": "src/logic/diagram/file.rs"
    },
    {
      "title": "Table parsing is index-only",
      "body": "src/logic/table.rs keeps the decoded text once as `Arc<String>` and indexes 12 bytes per record, which is why a million rows parse in under a tenth of a second per the README.",
      "severity": "info",
      "path": "src/logic/table.rs"
    },
    {
      "title": "Mermaid import is lossy by design",
      "body": "src/logic/mermaid.rs turns only what the canvas can draw and counts the rest in `skipped` rather than refusing the file: a bridge, not a renderer.",
      "severity": "info",
      "path": "src/logic/mermaid.rs"
    },
    {
      "title": "Formula cycles are detected, not fatal",
      "body": "`evaluate` short-circuits the untaken branch of a conditional and marks a reference cycle instead of recursing (formula.rs:635, test at 786).",
      "severity": "info",
      "path": "src/logic/formula.rs"
    }
  ]
}