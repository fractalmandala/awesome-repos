  "flows": [
    {
      "id": "open-note",
      "name": "Open a note",
      "trigger": "Click a note in the side panel",
      "steps": [
        "cmp:Nav",
        "cmp:Shell",
        "ipc:Vault",
        "cmp:Editor"
      ],
      "summary": "Tree row -> open_note -> file read -> editor.set_text, place recorded."
    },
    {
      "id": "autosave",
      "name": "Type and autosave",
      "trigger": "A keystroke in the note",
      "steps": [
        "cmp:Editor",
        "cmp:Shell",
        "ipc:Vault"
      ],
      "summary": "EditorEvent::Changed -> flush() writes the note atomically; title renames it."
    },
    {
      "id": "palette",
      "name": "Command palette",
      "trigger": "F10",
      "steps": [
        "cmd:ToggleCommands",
        "cmp:Palette",
        "cmp:Commands"
      ],
      "summary": "Palette opens in command mode, filters the catalogue, dispatches an action name."
    },
    {
      "id": "sync",
      "name": "Git sync",
      "trigger": "Ctrl+Shift+S",
      "steps": [
        "cmd:SyncVault",
        "ipc:Git",
        "state:ShellState"
      ],
      "summary": "commit, fetch, merge, push in background; conflicts land as two notes."
    },
    {
      "id": "open-csv",
      "name": "Open a CSV",
      "trigger": "Click a .csv in the side panel",
      "steps": [
        "cmp:Nav",
