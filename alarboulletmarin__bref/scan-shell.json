  "flows": [
    {
      "id": "open-note",
      "name": "Open a note",
      "trigger": "Click a row in the side panel",
      "steps": [
        "ext:Nav",
        "cmp:Sidebar",
        "cmp:Notes",
        "ipc:Vault",
        "ext:Editor"
      ],
      "summary": "Row -> open_from_nav -> load_note reads the file and fills the pane's Editor."
    },
    {
      "id": "autosave",
      "name": "Debounced autosave",
      "trigger": "A keystroke in the note",
      "steps": [
        "ext:Editor",
        "cmp:Notes",
        "ipc:Vault",
        "cmp:Toasts"
      ],
      "summary": "Changed bumps save_gen; 400 ms later flush() writes the note atomically."
    },
    {
      "id": "split-pane",
      "name": "Split the window",
      "trigger": "Ctrl+\\",
      "steps": [
        "cmd:SplitPane",
        "cmp:Pane",
