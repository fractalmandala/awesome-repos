    },
    {
      "id": "daemon-lifecycle",
      "name": "Engine survives the app",
      "trigger": "close the app window",
      "steps": [
        "cmp:AppMain",
        "state:ManagedEngine",
        "ipc:EngineIpc"
      ],
      "summary": "Detached zeron-engine keeps sessions; app reconnects with backoff."
    },
    {
      "id": "cross-device",
      "name": "Drive from another device",
      "trigger": "sign in and sync",
      "steps": [
