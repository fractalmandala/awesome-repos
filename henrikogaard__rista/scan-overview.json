  "flows": [
    {
      "id": "open-vault",
      "name": "Open a vault",
      "trigger": "OpenFolder action or CLI open",
      "steps": [
        "cmd:PaletteAction",
        "cmp:Windows",
        "cmp:AppCrate",
        "state:Vault",
        "ipc:VaultWatcher"
      ],
      "summary": "Folder becomes a page; watcher keeps index live."
    },
    {
      "id": "write-note",
      "name": "Write a note",
      "trigger": "edit in Document editor",
      "steps": [
        "cmp:AppCrate",
        "state:DocumentEnt",
        "state:Vault",
        "cmp:PreviewMod"
      ],
      "summary": "Autosave lands as plain .md; preview tabs re-render live."
    },
    {
      "id": "bases-view",
      "name": "Query the vault",
      "trigger": "open a .base file",
      "steps": [
        "cmp:BasesMod",
        "fn:BasesDSL",
        "state:Vault"
      ],
      "summary": "YAML filters+formulas select, group and render notes."
    },
    {
      "id": "agent-review",
      "name": "Agent proposes edits",
      "trigger": "agent write in the panel",
      "steps": [
        "ipc:AcpProcess",
        "cmp:AgentPanels",
        "state:DocumentEnt"
      ],
      "summary": "ACP write arrives as a diff for accept/reject before landing."
    },
    {
      "id": "cli-write",
      "name": "Drive app from CLI",
      "trigger": "rista CLI or rista:// url",
      "steps": [
        "ipc:CliIpc",
        "cmp:Windows",
        "cmd:PaletteAction"
      ],
      "summary": "Socket frame \u2192 dispatch \u2192 window navigation; read-only runs headless."
    }
  ],
