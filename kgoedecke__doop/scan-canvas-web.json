  "flows": [
    {
      "id": "open-canvas",
      "name": "Open a canvas",
      "trigger": "click a canvas card on Home",
      "steps": [
        "cmp:Home",
        "cmp:App",
        "cmp:CanvasPage",
        "state:CanvasStore",
        "ipc:Ws"
      ],
      "summary": "Route /c/:id joins the ws room and hydrates the store."
    },
    {
      "id": "drag-frame",
      "name": "Move a frame",
      "trigger": "drag a frame on the canvas",
      "steps": [
        "cmp:Stage",
        "cmp:FrameView",
        "state:CanvasStore",
        "ipc:Ws"
      ],
      "summary": "Stage drag writes to the store and streams position over ws."
    },
    {
      "id": "queue-agent-work",
      "name": "Queue agent work",
      "trigger": "submit in the prompt bar",
      "steps": [
        "cmd:PromptSubmit",
        "cmp:PromptBar",
        "ipc:Api",
        "state:CanvasStore"
      ],
      "summary": "Prompt bars a card / @mention; server resident team picks it up."
    },
    {
      "id": "agent-stream",
      "name": "Watch an agent design",
      "trigger": "agent streams HTML chunks over ws",
      "steps": [
        "ipc:Ws",
        "state:CanvasStore",
        "cmp:GhostFrames",
        "cmp:FrameView"
      ],
      "summary": "Reveal playback shows the frame building live."
    },
    {
      "id": "undo-edits",
      "name": "Undo / redo",
      "trigger": "cmd+z / cmd+y",
      "steps": [
        "cmd:UndoRedo",
        "fn:History",
        "cmp:CanvasPage"
      ],
      "summary": "Canvas keydown rewinds the local edit stacks."
    },
    {
      "id": "share-canvas",
      "name": "Share a canvas",
      "trigger": "Share button",
      "steps": [
        "cmp:CanvasPage",
        "cmp:ShareModal",
        "cmd:CopyShareLink",
        "ipc:Api"
      ],
      "summary": "Modal copies the canvas URL and sets invite/link access."
    },
    {
      "id": "local-claude",
      "name": "Enable local Claude",
      "trigger": "Connect Local Claude",
      "steps": [
        "cmp:CanvasPage",
        "state:LocalAgent",
        "ipc:Tauri",
        "ipc:Api"
      ],
      "summary": "Desktop webview invokes the CLI; server stores the preference."
    }
  ],
  "notes": [
    {
      "title": "CanvasPage is a god-layout",
      "body": "src/pages/CanvasPage.tsx (1672 LOC) renders ~15 components directly and owns import modals, shortcuts, share, present and onboarding wiring.",
      "severity": "alert",
      "path": "src/pages/CanvasPage.tsx"
    },
    {
      "title": "one store, high fan-in",
      "body": "Every panel and Stage child reads src/lib/store.ts; writes come from Stage, FrameView, PromptBar, FrameClip and ws message handling.",
      "severity": "warn",
      "path": "src/lib/store.ts"
    },
    {
      "title": "no router library",
      "body": "Routing is regex matches on location.pathname inside src/App.tsx with navigate() via history.pushState + manual popstate.",
      "severity": "info",
      "path": "src/App.tsx"
    },
    {
      "title": "desktop shell hooks are optional bridge",
      "body": "src/lib/localAgent.ts reads window.__TAURI__ / __DOOP_CLAUDE_CLI__ and degrades to a plain browser when absent.",
      "severity": "info",
      "path": "src/lib/localAgent.ts"
    },
    {
      "title": "close-code routing is careful",
      "body": "ws.ts maps 4401\u2192reload to sign-in, 4403\u2192home, 4404\u2192not-found; superseded sockets are guarded to avoid double reconnects.",
      "severity": "info",
      "path": "src/lib/ws.ts"
    }
  ]
}