  "flows": [
    {
      "id": "drop-and-ask",
      "name": "Drop a file, type intent",
      "trigger": "command bar + Return",
      "steps": [
        "cmd:CommandBar",
        "fn:IntentParser",
        "state:Catalog",
        "cmp:JobsEngine",
        "state:History"
      ],
      "summary": "Best tool picked; result written as a NEW file next to the original."
    },
    {
      "id": "undo-job",
      "name": "Undo a result",
      "trigger": "undo in history",
      "steps": [
        "state:History",
        "cmp:JobsEngine",
        "cmp:DesktopApp"
      ],
      "summary": "Undo moves the result file to the Trash, never deletes."
    },
    {
      "id": "mcp-tools",
      "name": "Agents use the tools",
      "trigger": "panoply mcp in Claude/Cursor",
      "steps": [
        "cmd:McpServe",
        "ipc:McpCrate",
        "shared:CoreCrate",
        "cmp:ImageCrate"
      ],
      "summary": "Every tool exposed over MCP; nothing uploaded."
    },
    {
      "id": "cli-script",
      "name": "Script a conversion",
      "trigger": "panoply convert in the shell",
      "steps": [
        "cmd:CliRun",
        "cmp:CliCrate",
        "shared:CoreCrate",
        "cmp:PdfCrate"
      ],
      "summary": "Headless runs share the desktop's tool core."
    },
    {
      "id": "disk-review",
      "name": "Review disk space",
      "trigger": "disk view",
      "steps": [
        "cmp:UiMod",
        "cmp:FindDisk",
        "cmp:DesktopApp"
      ],
      "summary": "disk.rs + panoply-disk find space hogs with review delete."
    }
  ],
